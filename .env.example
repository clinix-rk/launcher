# PostgreSQL Configuration
POSTGRES_DB=clinix_datastore
POSTGRES_USER=clinix_application
POSTGRES_PASSWORD=your_secure_password_here

# Spring Boot Configuration
SPRING_JPA_HIBERNATE_DDL_AUTO=validate
SPRING_PROFILES_ACTIVE=prod

# Application Configuration
APP_NAME=Clinix
APP_ENV=production

# Frontend Configuration
REACT_APP_ENV=production
REACT_APP_API_URL=http://localhost/api

# GitHub Container Registry
GHCR_ORG=clinix-rk
GHCR_USERNAME=your_github_username
GHCR_TOKEN=your_github_token

# Crash reports (GitHub Issues API)
# Create a fine-grained PAT with Issues: Read and Write on this repository only.
GITHUB_REPORT_REPO=clinix-rk/launcher
GITHUB_REPORT_TOKEN=
GITHUB_REPORT_LABELS=crash-report

# Auto-update (checks on launch and on an interval; always prompts before applying)
AUTO_UPDATE_ENABLED=true
AUTO_UPDATE_INTERVAL_HOURS=6

# JWT token secret for future auth usage
JWT_SECRET=min-32bit-secret-key
